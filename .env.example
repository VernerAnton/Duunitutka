# --- required ---
TAVILY_API_KEY=            # https://app.tavily.com — free tier: 1,000 searches/month
TELEGRAM_BOT_TOKEN=        # from @BotFather
TELEGRAM_CHAT_ID=          # your user or group chat id

# --- optional ---
# In production this MUST live on a Railway Volume mounted at /data, or every
# run starts with an empty database and re-notifies everything. See README.
DB_PATH=/data/duunitutka.db

# Comma-separated. Leave unset (as below) to use the defaults shown here.
# LOCATIONS=Helsinki,Espoo,Kauniainen,Vantaa,Kirkkonummi
# PHRASES=osa-aikainen asiakaspalvelu,part-time customer service
